<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>Homepage</title>
</head>
<body>
<%- include("partials/logo.ejs")%>
<p>
<a href="/sign-up">Sign up</a>
</p>

<p>
<a href="/log-in">Login</a>
</p>


<% if(messages.length !== 0) {%>
<table>
<thead>
<tr>
<% if(locals.isAdmin) {%>
<th>Author</th>
<th>Message</th>
<th>Date</th>
<% } else if(locals.isMember) {%>
<th>Author</th>
<th>Date</th>
<% } else {%>
<th>Message</th>
<th>Date</th>
<% } %>
</tr>
</thead>

<tbody>
<% messages.forEach(message => {%>
<tr>
<% if(locals.isAdmin) {%>
<td><%= message.author%></td>
<td><%= message.message%></td>
<td><%= message.date%></td>
<td><a href="/delete_message?id=<%= message.id%>">Delete</a></td>
<% } else if(locals.isMember){%>
<td><%= message.author%></td>
<td><%= message.date%></td>
<% } else {%>
<td><%= message.message%></td>
<td><%= message.date%></td>
<% } %>
</tr>
<% }); %>
</tbody>
</table>
<% } %>
</body>
</html>
