<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>Homepage</title>
</head>
<body>
<p>
<a href="/sign-up">Sign up</a>
</p>

<p>
<a href="/log-in">Login</a>
</p>


<table border="1">
<thead>
<tr>
<th>Author</th>
<th>Message</th>
<th>Date</th>
</tr>
</thead>

<tbody>
<% messages.forEach(message => {%>
<tr>
<td><%= message.author%></td>
<td><%= message.message%></td>
<td><%= message.date%></td>
</tr>
<% }); %>
</tbody>
</table>
</body>
</html>
